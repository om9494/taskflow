output "container_name" {
  description = "Name of the provisioned Docker demonstration container"
  value       = docker_container.taskflow_iac_container.name
}

output "container_id" {
  description = "Unique container ID generated by Docker"
  value       = docker_container.taskflow_iac_container.id
}

output "network_name" {
  description = "Name of the dedicated Docker network created by Terraform"
  value       = docker_network.taskflow_iac_network.name
}

output "internal_port" {
  description = "Internal container port"
  value       = var.internal_port
}

output "host_port" {
  description = "Host port mapped on Windows laptop"
  value       = var.host_port
}

output "application_url" {
  description = "URL to access the Terraform-provisioned container in your web browser"
  value       = "http://localhost:${var.host_port}"
}
